{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tc-sgb-api-list.local/schemas/address.schema.json",
  "title": "Address IOC",
  "description": "An IP address indicator of compromise (IOC) record.",
  "type": "object",
  "required": [
    "id",
    "ip",
    "type",
    "created_date",
    "last_modified_date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the IOC record."
    },
    "ip": {
      "type": "string",
      "format": "ipv4",
      "description": "The IPv4 address value.",
      "examples": ["192.168.1.1", "10.0.0.1"]
    },
    "ip_v6": {
      "type": "string",
      "format": "ipv6",
      "description": "The IPv6 address value (optional)."
    },
    "type": {
      "type": "string",
      "enum": ["address"],
      "const": "address",
      "description": "IOC type discriminator."
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Confidence score (0-100) in the IOC's validity."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true,
      "maxItems": 50,
      "description": "Descriptive tags for categorization."
    },
    "threat_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Adversary",
          "Botnet",
          "Hacktivist",
          "Malware",
          "Phishing",
          "Ransomware",
          "Suspicious",
          "Threat Actor",
          "Unknown"
        ]
      },
      "uniqueItems": true,
      "description": "Classified threat types."
    },
    "geo_location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$"
        },
        "country_name": {
          "type": "string",
          "description": "Full country name."
        },
        "city": {
          "type": "string",
          "description": "City name."
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "asn": {
      "type": "integer",
      "minimum": 0,
      "description": "Autonomous System Number."
    },
    "whois": {
      "type": "object",
      "properties": {
        "registrant": { "type": "string" },
        "registrant_email": { "type": "string", "format": "email" },
        "registrar": { "type": "string" },
        "registration_date": { "type": "string", "format": "date" },
        "expiration_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "description": "Data source identifier.",
      "minLength": 1,
      "maxLength": 255
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "expired", "false_positive"],
      "default": "active"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp."
    },
    "last_modified_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last-modified timestamp."
    },
    "last_seen_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last observed activity."
    }
  },
  "additionalProperties": false
}
