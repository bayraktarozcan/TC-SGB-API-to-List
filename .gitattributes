# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicit text types
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files — do not diff or normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
*.tar.gz binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pem binary
*.p12 binary
*.pfx binary
