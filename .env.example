# T.C. Siber Güvenlik Başkanlığı (TC-SGB) API Configuration
# Copy this file to .env and adjust values as needed.
#
# NOTE: The SGB API requires NO authentication.
# These settings are optional overrides — sensible defaults are hardcoded.

# API base URL (without trailing slash)
TC_SGB_API_BASE_URL=https://siberguvenlik.gov.tr

# Request settings
TC_SGB_REQUEST_TIMEOUT=60
TC_SGB_MAX_RETRIES=3
TC_SGB_RATE_LIMIT_PER_SECOND=5

# Output settings
TC_SGB_OUTPUT_DIR=output
TC_SGB_LOG_LEVEL=INFO

# Proxy (optional)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
