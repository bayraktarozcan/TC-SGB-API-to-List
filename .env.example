# Threat Connect SGB API Configuration
# Copy this file to .env and fill in the values

# API base URL (without trailing slash)
TC_SGB_API_BASE_URL=https://api.threatconnect.com/v3

# API credentials
TC_SGB_API_KEY=your_api_key_here
TC_SGB_API_SECRET=your_api_secret_here

# Request settings
TC_SGB_REQUEST_TIMEOUT=30
TC_SGB_MAX_RETRIES=3
TC_SGB_RATE_LIMIT_PER_SECOND=10

# Output settings
TC_SGB_OUTPUT_DIR=output
TC_SGB_LOG_LEVEL=INFO

# Proxy (optional)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
